<!DOCTYPE html>
<html>
<head>
<title>Rodar animação</title>

<style>
body {
  background: black;
  color: white;
  text-align: center;
  font-family: Arial;
  margin-top: 100px;
}

button {
  background: green;
  color: white;
  font-size: 25px;
  padding: 20px 40px;
  border: none;
  border-radius: 10px;
}

#susto {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: black;
}

#susto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
</style>

</head>

<body>

<h1>Rodar animação</h1>

<button onclick="ativarSusto()">Rodar animação</button>

<div id="susto">
  <img src="imagem.png">
</div>

<audio id="som" src="som.mp3"></audio>

<script>
function ativarSusto() {

  document.getElementById("susto").style.display = "block";

  document.getElementById("som").play();

}
</script>

</body>
</html>
